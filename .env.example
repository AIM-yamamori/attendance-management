ONEDRIVE_SHARE_URL=
SERVICE_START_MONTH=
SESSION_SECRET=

# Day1: adminアカウント初期構築時のみ使用する初期パスワード
# 初回起動後は速やかに変更すること（SC-07 または DB直接更新）
INITIAL_ADMIN_PASSWORD=

# Day3: OneDrive共有URL経由のAPI仕様が未検証のため（基本設計書14章）、
# 暫定的にローカルディレクトリを疑似OneDriveとして使う実装にしている。
# ここで指定したディレクトリがOneDriveのルートディレクトリ相当になる。
# 実際のOneDrive共有URL連携が確定したら、ONEDRIVE_SHARE_URLを使う
# 実装に adapters/onedrive_adapter.py を差し替える。
ONEDRIVE_LOCAL_ROOT=

# Day3: 月次ファイル名・テンプレートファイル名に使う会社名（要件定義書5.1節）
# 実際の表記は依頼者確認事項のため未確定（基本設計書14章参照）
COMPANY_NAME=
