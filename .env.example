# OneDrive共有URL（例：https://1drv.ms/u/s!xxxxxxxxxxxxxxxxxxxxxx）
ONEDRIVE_SHARE_URL=

# データベースのパス
DB_PATH=

# サービス開始月（YYYYMM形式。例：202607）
# これよりも前のデータにアクセスできないようにするため
SERVICE_START_MONTH=

# Day1: adminアカウント初期構築時のみ使用する初期パスワード
# 初回起動後は速やかに変更すること（SC-07 または DB直接更新）
INITIAL_ADMIN_PASSWORD=

# Microsoft Graph API（OneDrive共有URL連携用。クライアントクレデンシャルフロー）
# 3つとも設定されていない場合、adapters/onedrive_adapter.py は自動的に
# ONEDRIVE_LOCAL_ROOT を使ったローカル疑似OneDrive実装にフォールバックする。
# 本番運用ではこの3つを必ず設定すること（手順は「Azure ADアプリ登録手順書」参照）。
ONEDRIVE_TENANT_ID=
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=

# Day3: 上記Graph API連携用の環境変数が未設定の場合にのみ使われる、
# ローカルディレクトリを疑似OneDriveとして使うフォールバック実装用の設定。
# ここで指定したディレクトリがOneDriveのルートディレクトリ相当になる。
ONEDRIVE_LOCAL_ROOT=

# Day3: 月次ファイル名・テンプレートファイル名に使う会社名（要件定義書5.1節）
# エクセルファイル名の先頭にある文字列
COMPANY_NAME=【ここに会社名】